          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nlet jsonData = pm.response.json();\r\n\r\npm.test(\"Summary Contains\", function () {\r\n\r\n  pm.expect(jsonData.fields.summary).to.include(\"Task created through Postman\");\r\n})\r\n\r\npm.test(\"Project Key Validation\", function () {\r\n\r\n    pm.expect(jsonData.key).to.equal(pm.collectionVariables.get(\"issueKey\"));\r\n})\r\n\r\npm.test(\"Issue type Validation\",function(){\r\n\r\n    pm.expect(jsonData.fields.issuetype.name).to.equal(\"Task\")\r\n})\r\n\r\npm.test(\"Description Validation\",function(){\r\n\r\n    pm.expect(jsonData.fields.description).to.equal(\"Verify that the page loads successfully.\")\r\n})\r\n"
            ]
          }
        }
      ],
